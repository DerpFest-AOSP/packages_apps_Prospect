<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.derpfest.prospect">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <receiver
            android:name=".SmartSpacerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kieronquinn.app.smartspacer.ACTION_UPDATE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".StayDerped"
            android:exported="true"
            android:label="@string/stayderped_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/stayderped_widget_info" />
        </receiver>

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".IconPackActivity" />

    </application>
</manifest>
