<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#33000000"
    android:padding="4dp">

    <!-- Battery Status Block -->
    <LinearLayout
        android:id="@+id/noblesse_status_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Battery Level Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Battery Level Bar -->
            <View
                android:id="@+id/battery_level_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:background="@color/battery_good" />

            <!-- Empty space for remaining battery -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3"
                android:background="#33FFFFFF" />
        </LinearLayout>

        <!-- Battery Percentage -->
        <TextView
            android:id="@+id/noblesse_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Charging Indicator -->
        <ImageView
            android:id="@+id/charging_indicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_charging"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Additional Info Container -->
    <LinearLayout
        android:id="@+id/additional_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/noblesse_status_block"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <!-- Temperature -->
        <TextView
            android:id="@+id/battery_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Health Status -->
        <TextView
            android:id="@+id/battery_health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</RelativeLayout>
